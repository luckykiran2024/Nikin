# =====================================================
# ParcelPeer Production Environment Variables
# =====================================================
# Copy this file to .env and fill in your values
#
# IMPORTANT: Never commit .env file with real values!
# =====================================================

# ===========================================
# SUPABASE CONFIGURATION (Required for Production)
# ===========================================
# Get these from your Supabase project dashboard:
# 1. Go to https://supabase.com/dashboard
# 2. Select your project
# 3. Go to Settings > API
# 4. Copy the URL and anon key

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ===========================================
# API CONFIGURATION
# ===========================================
# Option 1: Supabase Edge Functions (Recommended for production)
# Deploy the edge functions first, then use this URL:
EXPO_PUBLIC_API_URL=https://your-project-id.supabase.co/functions/v1/api

# Option 2: Rork Backend (For development/preview)
# Leave empty to use the built-in Rork backend
# EXPO_PUBLIC_RORK_API_BASE_URL=

# ===========================================
# APP CONFIGURATION
# ===========================================
# Platform fee percentage (default: 10%)
EXPO_PUBLIC_PLATFORM_FEE_PERCENT=10

# Minimum app version required
EXPO_PUBLIC_MIN_APP_VERSION=1.0.0

# ===========================================
# OPTIONAL FEATURES
# ===========================================
# Enable push notifications (requires Expo push setup)
EXPO_PUBLIC_PUSH_NOTIFICATIONS_ENABLED=false

# Enable analytics (requires setup)
EXPO_PUBLIC_ANALYTICS_ENABLED=false

# Enable debug mode (shows extra logs)
EXPO_PUBLIC_DEBUG_MODE=false

# ===========================================
# PAYMENT GATEWAY (For production payments)
# ===========================================
# Razorpay credentials - Get from https://razorpay.com/
# EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxx
# RAZORPAY_KEY_SECRET=your-secret-key (server-side only)

# ===========================================
# SUPABASE SERVICE KEYS (Server-side only)
# ===========================================
# These are used by Edge Functions, NOT the mobile app
# Never expose these in client-side code!
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# DEPLOYMENT NOTES
# ===========================================
# For Rork Platform:
#   - The app works out of the box with the built-in backend
#   - Data is stored in-memory (for demo/preview)
#   - For persistence, configure Supabase
#
# For Production (App Store/Play Store):
#   1. Create a Supabase project
#   2. Run migrations: supabase/migrations/*.sql
#   3. Deploy edge functions: supabase functions deploy api
#   4. Configure all EXPO_PUBLIC_* variables
#   5. Build with EAS: eas build
# =====================================================
